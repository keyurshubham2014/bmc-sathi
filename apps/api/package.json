{
  "name": "bmc-sathi-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:migrate": "prisma migrate deploy",
    "db:views": "prisma db execute --file prisma/views.sql --schema prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:load": "tsx --env-file=.env src/pipeline/load.ts",
    "db:enrich": "tsx --env-file=.env src/pipeline/enrich.ts",
    "db:group": "tsx --env-file=.env src/pipeline/group.ts",
    "db:social": "tsx --env-file=.env src/pipeline/social.ts",
    "db:summarise": "tsx --env-file=.env src/pipeline/summarise.ts",
    "db:verify": "tsx --env-file=.env src/pipeline/verify.ts",
    "db:setup": "npm run db:migrate && npm run db:views && npm run db:seed && npm run db:load && npm run db:enrich && npm run db:group && npm run db:social && npm run db:verify",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
